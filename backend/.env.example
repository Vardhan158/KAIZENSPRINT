PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/kaizen_sprint
JWT_SECRET=your_jwt_secret_here
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=your_secure_admin_password

CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

BREVO_API_KEY=your_brevo_api_key
BREVO_USER=your_brevo_smtp_user
BREVO_PASS=your_brevo_smtp_password
BREVO_FROM_EMAIL=your_verified_sender_email
EMAIL_FROM_NAME="KaizenSprint Admin"

SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_brevo_smtp_user
SMTP_PASS=your_brevo_smtp_password
SMTP_FROM="KaizenSprint Admin" <your_verified_sender_email>

NODE_ENV=development
